# ============================================================
# OptiBot – Environment Variables Sample
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control!
# ============================================================

# Google Gemini API Key – get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Corpus display name – auto-created if not set
CORPUS_NAME=optisigns_support_corpus

# (Optional) Corpus resource name (populated after first run)
# CORPUS_RESOURCE_NAME=corpora/optisigns-support-corpus-xxxx
